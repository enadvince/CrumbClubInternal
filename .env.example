# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Either name works: NEXT_PUBLIC_SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Used by the server routes for tablet pairing and PIN sign-in (owner view, co-owners).
# Either name works: SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: where "Contact support" on public pages points (UTM tags are added).
NEXT_PUBLIC_SUPPORT_URL=

# Edge Function secrets for the nightly backup (set with `supabase secrets set`, not here):
#   BACKUP_CRON_SECRET   must match the Vault secret crumbclub_backup_secret
#   RESEND_API_KEY, BACKUP_EMAIL_TO, BACKUP_EMAIL_FROM   optional: email a summary of each backup
