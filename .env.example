# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Either name works: NEXT_PUBLIC_SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Used solely by /api/device/pair to create the POS tablet's device login.
# Either name works: SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Owner invites (Owners page). Emails are sent through Resend (resend.com).
# Without these, invites are still created and the owner copies the link instead.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Crumb Club <invites@yourdomain.com>"
INVITE_EMAIL_FROM=
# Public address used in invite links, e.g. https://crumb-club-internal-two.vercel.app
# (defaults to the address the owner is using). Must not be behind Vercel Authentication.
SITE_URL=
